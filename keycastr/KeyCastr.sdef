<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="KeyCastr Terminology">
    <suite name="KeyCastr Suite" code="KCst" description="KeyCastr scripting support.">

        <class name="application" code="capp" description="The KeyCastr application.">
            <cocoa class="NSApplication"/>

            <property name="casting" code="KCca" type="boolean" access="rw"
                      description="Is KeyCastr currently capturing and displaying keystrokes?">
                <cocoa key="casting"/>
            </property>

            <property name="filter synthetic keystrokes" code="KCfs" type="boolean" access="rw"
                      description="When enabled, ignores synthetic keystrokes (e.g. from Talon Voice).">
                <cocoa key="filterSyntheticKeys"/>
            </property>

            <property name="show in dock" code="KCsd" type="boolean" access="rw"
                      description="Show KeyCastr icon in the Dock.">
                <cocoa key="showInDock"/>
            </property>

            <property name="show in menu bar" code="KCsm" type="boolean" access="rw"
                      description="Show KeyCastr icon in the menu bar.">
                <cocoa key="showInMenuBar"/>
            </property>

            <property name="display style" code="KCds" type="text" access="rw"
                      description="The visualizer style: &quot;Default&quot; or &quot;Svelte&quot;.">
                <cocoa key="currentVisualizerName"/>
            </property>

            <property name="key display mode" code="KCkd" type="text" access="rw"
                      description="Which keys to display: &quot;Command Keys Only&quot;, &quot;All Modified Keys&quot;, or &quot;All Keys&quot;.">
                <cocoa key="keyDisplayMode"/>
            </property>

            <property name="mouse display mode" code="KCmd" type="text" access="rw"
                      description="Mouse click display: &quot;None&quot;, &quot;With Mouse Pointer&quot;, &quot;With Current Visualizer&quot;, or &quot;With Pointer and Visualizer&quot;.">
                <cocoa key="currentMouseDisplayOptionName"/>
            </property>

            <property name="font size" code="KCfz" type="real" access="rw"
                      description="Font size for the keystroke display bezel.">
                <cocoa key="displayFontSize"/>
            </property>

            <property name="fade delay" code="KCfd" type="real" access="rw"
                      description="Seconds before the keystroke display begins to fade.">
                <cocoa key="displayFadeDelay"/>
            </property>

            <property name="fade duration" code="KCfn" type="real" access="rw"
                      description="Duration of the fade-out animation in seconds.">
                <cocoa key="displayFadeDuration"/>
            </property>

            <property name="keystroke delay" code="KCky" type="real" access="rw"
                      description="Seconds to wait before starting a new bezel for subsequent keystrokes.">
                <cocoa key="displayKeystrokeDelay"/>
            </property>

            <property name="bezel color" code="KCbc" type="text" access="rw"
                      description="Background color of the keystroke bezel as hex: &quot;#RRGGBB&quot; or &quot;#RRGGBBAA&quot;.">
                <cocoa key="bezelColor"/>
            </property>

            <property name="text color" code="KCtc" type="text" access="rw"
                      description="Text color of the keystroke display as hex: &quot;#RRGGBB&quot; or &quot;#RRGGBBAA&quot;.">
                <cocoa key="textColor"/>
            </property>
        </class>

        <command name="start casting" code="KCstStrt" description="Start capturing and displaying keystrokes.">
            <cocoa class="KCStartCastingCommand"/>
        </command>

        <command name="stop casting" code="KCstStop" description="Stop capturing and displaying keystrokes.">
            <cocoa class="KCStopCastingCommand"/>
        </command>

        <command name="toggle casting" code="KCstTogl" description="Toggle keystroke capturing on or off.">
            <cocoa class="KCToggleCastingCommand"/>
        </command>

    </suite>
</dictionary>
